
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BRAND -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BHtravel"
            android:textColor="@color/app_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Create a new trip"
            android:textColor="@color/app_text"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Let's plan your next adventure!"
            android:textColor="@color/app_secondary_text"
            android:textSize="15sp" />

        <!-- DESTINATION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Destination *"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_trip_card"
            android:backgroundTint="@color/app_input_background"
            android:hint="e.g. Rome"
            android:inputType="textCapWords"
            android:padding="15dp"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_secondary_text"
            android:textSize="15sp" />

        <!-- COUNTRY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Country *"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCountry"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_trip_card"
            android:backgroundTint="@color/app_input_background"
            android:hint="e.g. Italy"
            android:inputType="textCapWords"
            android:padding="15dp"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_secondary_text"
            android:textSize="15sp" />

        <!-- START DATE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Start date *"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStartDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/app_selected"
            android:text="Choose start date"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="15sp" />

        <!-- END DATE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="End date *"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEndDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/app_selected"
            android:text="Choose end date"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="15sp" />

        <!-- TRAVELERS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Number of travelers"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTravelers"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_trip_card"
            android:backgroundTint="@color/app_input_background"
            android:hint="1"
            android:inputType="number"
            android:padding="15dp"
            android:text="1"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_secondary_text"
            android:textSize="15sp" />

        <!-- NOTES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Notes"
            android:textColor="@color/app_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_trip_card"
            android:backgroundTint="@color/app_input_background"
            android:gravity="top"
            android:hint="Add some details about your trip..."
            android:inputType="textCapSentences|textMultiLine"
            android:padding="15dp"
            android:textColor="@color/app_text"
            android:textColorHint="@color/app_secondary_text"
            android:textSize="15sp" />

        <!-- SAVE TRIP -->
        <Button
            android:id="@+id/btnSaveTrip"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/app_primary"
            android:text="Create Trip"
            android:textAllCaps="false"
            android:textColor="@color/app_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- CANCEL -->
        <Button
            android:id="@+id/btnCancelTrip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/app_selected"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
