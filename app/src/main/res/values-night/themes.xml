<resources>

    <style name="Base.Theme.BHtravel" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/navy</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorOnSecondary">@color/navy</item>

        <!-- Background and surfaces -->
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="android:windowBackground">@color/dark_background</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Accent -->
        <item name="android:colorAccent">@color/dark_accent</item>

    </style>

    <style name="Theme.BHtravel" parent="Base.Theme.BHtravel" />

</resources>
